# Copy to .env.local (gitignored) and fill in real values.

# Supabase — lead store (server-only; never expose the service-role key client-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sales console secret. Gates the privileged /api/leads calls
# (GET list / DELETE clear / PATCH status). The public audit funnel does NOT
# need this — only reading/managing captured leads does.
#
# If unset, those endpoints fail closed (401) and the sales console shows no
# data — by design, so leads are never world-readable.
#
# Open the console at:  /?view=sales&key=YOUR_ADMIN_TOKEN
ADMIN_TOKEN=generate-a-long-random-string
